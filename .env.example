# ==============================================================================
# VPN Suite: Конфигурация проекта (vpn-bot + vpn-dashboard)
# Скопируйте этот файл в .env и укажите ваши боевые значения
# ==============================================================================

# Telegram Bot API Token от @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Цифровой Telegram ID администратора бота (можно узнать через @userinfobot)
ADMIN_TG_ID=123456789

# Путь к локальной SQLite базе данных панели 2S-UI (или S-UI)
DB_PATH=/usr/local/s-ui/db/s-ui.db

# Путь к локальной служебной базе данных бота (история уведомлений, отложенные удаления сообщений)
BOT_DATA_DB=bot_data.db

# Название вашего VPN сервиса для приветственного экрана и дашборда
PROJECT_NAME="My VPN Service"

# Основной домен сервера, на котором работает панель 2S-UI
MAIN_DOMAIN=example.com

# Порт панели 2S-UI для выдачи подписок (https://{MAIN_DOMAIN}:{PANEL_PORT}/sub/{client_name})
PANEL_PORT=2096

# Полный адрес подписок панели без имени клиента (страница дашборда строит из него ссылку).
# install.sh заполняет его сам по настройкам панели (схема, subDomain, subPort, subPath).
PANEL_SUB_URL=https://example.com:2096/sub

# Поддомен веб-дашборда (ссылки, которые бот выдает пользователям: https://{SUB_DOMAIN}/{client_name})
# Если HTTPS работает не на 443, укажите порт: sub.example.com:8443
SUB_DOMAIN=sub.example.com

# Юзернейм основного Telegram-бота подписок (без символа @)
BOT_USERNAME=my_vpn_bot

# Юзернейм аккаунта или бота техподдержки в Telegram (без символа @)
SUPPORT_BOT_USERNAME=my_vpn_support_bot

# Название и ссылка на информационный канал или чат сервиса
SERVICE_GROUP_NAME="Официальный канал сервиса"
SERVICE_GROUP_URL=https://t.me/your_channel_or_group

# Номер карты для оплаты подписок (отображается в Telegram-боте)
CARD_NUMBER="0000 0000 0000 0000"

# Реквизиты для оплаты (поддерживается HTML-разметка, например <code> для быстрого копирования)
PAYMENT_REQUISITES="Карта: <code>0000 0000 0000 0000</code>\n<i>Нажмите на номер, чтобы скопировать</i>"

# Тарифы: дни:цена[:скидка%] через запятую. В боте показываются как «30 дней», «90 дней» и т.д.
# (старая запись в месяцах, где все сроки не больше 24, читается как 1→30, 3→90, 6→180, 12→365 дней)
TARIFFS="30:200,90:570:5,180:1080:10,365:2000:15"

# ------------------------------------------------------------------------------
# Автовыдача подписок через REST API панели (docs/panel-api.md)
# Если PANEL_API_URL, PANEL_API_TOKEN или PANEL_INBOUND_IDS пусты, бот работает как раньше:
# после подтверждения оплаты подписку создаёт администратор вручную.
# ------------------------------------------------------------------------------

# Адрес API панели: <схема>://<домен панели>:<порт панели><webPath>apiv2/
# Домен должен совпадать с webDomain в настройках панели, иначе панель ответит 403
PANEL_API_URL=https://panel.example.com:2095/app/apiv2/

# API-токен: панель 2S-UI → Настройки → API-токены (передаётся в заголовке Token). Держите в секрете
PANEL_API_TOKEN=

# ID входящих (inbounds) панели через запятую — к ним подключаются новые подписки
PANEL_INBOUND_IDS=1,2

# Лимит трафика подписки в ГБ за месяц, 0 — без лимита
SUB_TRAFFIC_GB=250

# Сколько устройств (IP) одновременно, 0 — без лимита
SUB_DEVICE_LIMIT=2

# В какое число месяца сбрасывать трафик (1-31), 0 — каждые 30 дней от создания подписки
SUB_RESET_DAY_OF_MONTH=0

# Группа клиента в панели для купленных подписок: новым всегда, при продлении — только если группы нет.
# Пусто — группу не задавать (мастер install.sh по умолчанию предлагает buyer)
SUB_GROUP=buyer

# Часовой пояс для дат в уведомлениях (install.sh прописывает его в службы systemd)
TIMEZONE=Europe/Moscow
