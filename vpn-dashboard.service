# Шаблон: install.sh подставляет свои пути и добавляет Environment=TZ=<часовой пояс>
[Unit]
Description=VPN Dashboard Validation Microservice
After=network.target

[Service]
User=vpnbot
Group=vpnbot
WorkingDirectory=/var/www/2S-UI-TGbot-Dashboard
ExecStart=/var/www/2S-UI-TGbot-Dashboard/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# См. комментарий в vpn-bot.service
AmbientCapabilities=CAP_DAC_OVERRIDE
CapabilityBoundingSet=CAP_DAC_OVERRIDE
# ReadWritePaths нет: вся файловая система, включая базу панели, только для чтения

[Install]
WantedBy=multi-user.target
