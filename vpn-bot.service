# Шаблон: install.sh подставляет свои пути и добавляет Environment=TZ=<часовой пояс>
[Unit]
Description=Telegram VPN Subscriptions Bot
After=network-online.target
Wants=network-online.target

[Service]
User=vpnbot
Group=vpnbot
WorkingDirectory=/var/www/2S-UI-TGbot-Dashboard
ExecStart=/var/www/2S-UI-TGbot-Dashboard/venv/bin/python bot.py
Restart=always
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Файлы панели принадлежат root с правами 600, отсюда единственная capability.
# Папка базы 2S-UI не входит в ReadWritePaths: ProtectSystem=strict монтирует её
# только для чтения, и записать в базу панели бот не может даже с этой capability.
AmbientCapabilities=CAP_DAC_OVERRIDE
CapabilityBoundingSet=CAP_DAC_OVERRIDE
# Писать можно только в свою bot_data.db и её журнал в папке проекта
ReadWritePaths=/var/www/2S-UI-TGbot-Dashboard

[Install]
WantedBy=multi-user.target
